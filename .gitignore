# ============================================
# Environment / secrets — NEVER commit real values
# ============================================
.env
.env.*
!.env.example

# ============================================
# Backend (Python)
# ============================================
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================
# Frontend (Node)
# ============================================
node_modules/
dist/
dist-ssr/
*.local

# ============================================
# Database dumps / backups / local uploads
# ============================================
*.dump
*.backup
*.bak
*.sql.gz
*.tar.gz
*.sqlite3
uploads/
storage/

# ============================================
# Logs
# ============================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# OS / editor
# ============================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln